-- ============================ helpers ============================
local function getHum(plr)
    local c = plr and plr.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getHRP(plr)
    local c = plr and plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function isAlive(plr)
    local h = getHum(plr)
    return h and h.Health > 0
end
local function sameTeam(plr, check)
    if not check then return false end
    return plr.Team ~= nil and plr.Team == LP.Team
end
local function toScreen(world)
    local sp, on = Camera:WorldToViewportPoint(world)
    return Vector2.new(sp.X, sp.Y), on
end

local rcParams = RaycastParams.new()
rcParams.FilterType = Enum.RaycastFilterType.Exclude
local function los(targetPart)
    if not State.Aimbot.WallCheck then return true end
    rcParams.FilterDescendantsInstances = { LP.Character, targetPart.Parent }
    local origin = Camera.CFrame.Position
    return Workspace:Raycast(origin, targetPart.Position - origin, rcParams) == nil
end

-- ============================ aimbot ============================
local function findTarget()
    local center, best, bestD = Camera.ViewportSize / 2, nil, State.Aimbot.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not sameTeam(plr, State.Aimbot.TeamCheck) and isAlive(plr) then
            local part = plr.Character:FindFirstChild(State.Aimbot.Part)
                          or plr.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, on = toScreen(part.Position)
                if on then
                    local d = (sp - center).Magnitude
                    if d < bestD and los(part) then
                        bestD, best = d, part
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not (State.Aimbot.Enabled and AimbotHolding) then return end
    local t = findTarget()
    if t then
        Camera.CFrame = Camera.CFrame:Lerp(
            CFrame.new(Camera.CFrame.Position, t.Position),
            State.Aimbot.Smooth)
    end
end)

UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == State.Aimbot.Key then AimbotHolding = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.KeyCode == State.Aimbot.Key then AimbotHolding = false end
end)

