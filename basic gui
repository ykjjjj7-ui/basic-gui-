local function makeESP(plr)
    if plr == LP or EspCache[plr] then return end
    local box       = Drawing.new("Square")  box.Thickness = 1  box.Filled = false  box.Color = Color3.fromRGB(0,255,120)  box.Visible = false
    local name      = Drawing.new("Text")    name.Size = 14      name.Center = true  name.Outline = true  name.Color = Color3.new(1,1,1)  name.Visible = false
    local healthBg  = Drawing.new("Square")  healthBg.Filled = true  healthBg.Color = Color3.new(0,0,0)      healthBg.Visible = false
    local healthBar = Drawing.new("Square")  healthBar.Filled = true  healthBar.Color = Color3.fromRGB(0,255,0)  healthBar.Visible = false
    local dist      = Drawing.new("Text")    dist.Size = 13      dist.Center = true  dist.Outline = true  dist.Color = Color3.fromRGB(200,200,200)  dist.Visible = false
    EspCache[plr] = { Box = box, Name = name, HealthBg = healthBg, HealthBar = healthBar, Distance = dist }
end

local function clearESP(plr)
    local e = EspCache[plr]; if not e then return end
    for _, d in pairs(e) do d:Remove() end
    EspCache[plr] = nil
end

for _, plr in ipairs(Players:GetPlayers()) do makeESP(plr) end
Players.PlayerAdded:Connect(makeESP)
Players.PlayerRemoving:Connect(clearESP)

local function corners(hrp)
    local minX, minY, maxX, maxY, any = math.huge, math.huge, -math.huge, -math.huge, false
    for _, part in ipairs(hrp.Parent:GetChildren()) do
        if part:IsA("BasePart") then
            for _, sx in ipairs({-0.5, 0.5}) do
            for _, sy in ipairs({-0.5, 0.5}) do
            for _, sz in ipairs({-0.5, 0.5}) do
                local w = part.CFrame * Vector3.new(part.Size.X*sx, part.Size.Y*sy, part.Size.Z*sz)
                local sp, on = toScreen(w)
                if on then
                    any = true
                    minX, maxX = math.min(minX, sp.X), math.max(maxX, sp.X)
                    minY, maxY = math.min(minY, sp.Y), math.max(maxY, sp.Y)
                end
            end end end
        end
    end
    if not any then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

RunService.RenderStepped:Connect(function()
    for plr, e in pairs(EspCache) do
        local hrp, hum = getHRP(plr), getHum(plr)
        if State.ESP.Enabled and hrp and hum and hum.Health > 0
           and not sameTeam(plr, State.ESP.TeamCheck) then
            local tl, br = corners(hrp)
            if tl then
                local w, h = br.X - tl.X, br.Y - tl.Y
                local myPos = getHRP(LP) and getHRP(LP).Position
                local d = myPos and (hrp.Position - myPos).Magnitude or 0

                if State.ESP.Box then
                    e.Box.Size = Vector2.new(w, h); e.Box.Position = tl; e.Box.Visible = true
                else e.Box.Visible = false end

                if State.ESP.Name then
                    e.Name.Position = Vector2.new(tl.X + w/2, tl.Y - 16)
                    e.Name.Text = plr.Name; e.Name.Visible = true
                else e.Name.Visible = false end

                if State.ESP.Health then
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local barH = h * pct
                    e.HealthBg.Position  = Vector2.new(tl.X - 6, tl.Y)
                    e.HealthBg.Size      = Vector2.new(3, h)
                    e.HealthBar.Position = Vector2.new(tl.X - 6, tl.Y + (h - barH))
                    e.HealthBar.Size     = Vector2.new(3, barH)
                    e.HealthBar.Color    = Color3.fromRGB(255*(1-pct), 255*pct, 0)
                    e.HealthBg.Visible = true; e.HealthBar.Visible = true
                else e.HealthBg.Visible = false; e.HealthBar.Visible = false end

                if State.ESP.Distance then
                    e.Distance.Position = Vector2.new(tl.X + w/2, br.Y + 2)
                    e.Distance.Text = string.format("[%d]", math.floor(d))
                    e.Distance.Visible = true
                else e.Distance.Visible = false end
            else
                for _, d in pairs(e) do d.Visible = false end
            end
        else
            for _, d in pairs(e) do d.Visible = false end
        end
    end
end)

