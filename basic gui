-- ============================ state ============================
local State = {
    Aimbot    = { Enabled = false, FOV = 120, Smooth = 0.35, TeamCheck = true, WallCheck = false, Part = "Head", Key = Enum.KeyCode.E },
    Walkspeed = { Enabled = false, Value = 32 },
    Fly       = { Enabled = false, Speed = 50 },
    ESP       = { Enabled = false, Box = true, Name = true, Health = true, Distance = true, TeamCheck = true },
}

local AimbotHolding = false
local FlyConn, FlyBV, FlyBG = nil, nil, nil
